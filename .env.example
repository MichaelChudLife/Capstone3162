# Copy this file to .env for local development. Never commit .env.

# Postgres connection. `npm run db:local` starts one on this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/cca_hub"

# Signs login cookies. Production needs a random value of at least 32 characters:
#   openssl rand -base64 32
SESSION_SECRET=""

# Password for the 5 demo accounts when the database is first seeded.
# Leave empty locally to use the demo password from the README. Required on Vercel.
SEED_PASSWORD=""

# Time zone used for due dates and greetings on the server.
APP_TIME_ZONE="Australia/Melbourne"
