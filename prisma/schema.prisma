generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AccessRole {
  IT_DIRECTOR
  COMMITTEE_DIRECTOR
  EVENTS_DIRECTOR
  MARKETING_DIRECTOR
  FINANCE_DIRECTOR
  COMMITTEE_MEMBER
}

model Member {
  id           String       @id @default(cuid())
  name         String
  initials     String
  color        String
  role         String
  accessRole   AccessRole   @default(COMMITTEE_MEMBER)
  tasks        Task[]       @relation("TaskAssignees")
  budgetItems  BudgetItem[]
}

model Event {
  id          String       @id @default(cuid())
  title       String
  date        DateTime
  location    String       @default("")
  description String       @default("")
  tasks       Task[]
  budgetItems BudgetItem[]
  createdAt   DateTime     @default(now())
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  assignees   Member[]   @relation("TaskAssignees")
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String?
  createdAt   DateTime   @default(now())

  @@index([eventId])
}

model BudgetItem {
  id           String   @id @default(cuid())
  label        String
  expectedCost Decimal  @db.Decimal(10, 2)
  actualCost   Decimal  @db.Decimal(10, 2)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String
  recordedBy   Member?  @relation(fields: [recordedById], references: [id])
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([eventId])
}
