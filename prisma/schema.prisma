generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AccessRole {
  IT_DIRECTOR
  COMMITTEE_DIRECTOR
  EVENTS_DIRECTOR
  MARKETING_DIRECTOR
  FINANCE_DIRECTOR
  COMMITTEE_MEMBER
}

model Member {
  id         String     @id @default(cuid())
  name       String
  initials   String
  color      String
  role       String
  accessRole AccessRole @default(COMMITTEE_MEMBER)
  tasks      Task[]     @relation("TaskAssignees")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String   @default("")
  description String   @default("")
  tasks       Task[]
  budgetItems BudgetItem[]
  createdAt   DateTime @default(now())
}

// F_REQ-7 — amounts are integer cents in AUD. actualCents is null until spend is recorded.
model BudgetItem {
  id            String   @id @default(cuid())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  description   String
  expectedCents Int
  actualCents   Int?
  createdAt     DateTime @default(now())

  @@index([eventId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  assignees   Member[]   @relation("TaskAssignees")
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String?
  createdAt   DateTime   @default(now())

  @@index([eventId])
}
